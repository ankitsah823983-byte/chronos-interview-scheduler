
NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chronos_db
DB_USER=postgres
DB_PASSWORD=your_local_database_password

# Session configuration
SESSION_SECRET=replace_with_a_long_random_secret

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Email configuration (Gmail SMTP)
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Chronos Interview Scheduler

# Invitation token encryption key (64 hexadecimal characters)
INVITATION_TOKEN_ENCRYPTION_KEY=replace_with_64_character_hex_key

# Email delivery worker
EMAIL_DELIVERY_MAX_ATTEMPTS=5
EMAIL_DELIVERY_POLL_INTERVAL_MS=30000
EMAIL_DELIVERY_STALE_SENDING_MS=60000
EMAIL_DELIVERY_WORKER_ENABLED=false

# Optional coordinator account setup
COORDINATOR_EMAIL=
COORDINATOR_NAME=
COORDINATOR_PASSWORD=

TEST_EMAIL_RECIPIENT=
